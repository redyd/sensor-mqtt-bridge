    {
        "id": "3c7e37899ebfc544",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Parser",
        "func": "const data = msg.payload;\nconst values = data.values;\n\nconst messages = [];\n\nfor (const [sensor, v] of Object.entries(values)) {\n    messages.push({ topic: `raw_${sensor}`, sensor, payload: v.raw });\n    messages.push({ topic: `smooth_${sensor}`, sensor, payload: v.smooth });\n    if (v.score !== undefined) {\n        messages.push({ topic: `score_${sensor}`, sensor, payload: v.score });\n    }\n}\n\nmessages.push({ topic: \"score\", sensor: \"global\", payload: data.score });\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 480,
        "wires": [
            [
                "adcd228a1217a89b"
            ]
        ]
    },
